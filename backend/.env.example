# Copia este archivo como .env y llena tus claves (todas gratuitas)

# Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq -> https://console.groq.com/keys
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Ollama local (opcional) -> https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Orden de proveedores de IA (si uno falla se usa el siguiente)
PROVEEDORES_IA=gemini,groq,ollama

# Ruta a ffmpeg (dejar vacío si ffmpeg está en el PATH)
FFMPEG_PATH=

# Origen permitido del frontend
FRONTEND_URL=http://localhost:3000

# --- Sprint 2 ---
# SQLite por defecto; para PostgreSQL: postgresql+psycopg://usuario:clave@host/db
DATABASE_URL=sqlite:///./datos.db
# Genera uno con: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
TOKEN_EXPIRA_HORAS=72
LIMITE_DIARIO_PROCESAMIENTOS=20

# --- Sprint 3 ---
# Tamaño máximo de archivos de video/audio subidos (MB)
MAX_SUBIDA_MB=200

# --- Sprint 4 ---
# Idioma del audio para Whisper (es, en, ...). Vacio = deteccion automatica.
IDIOMA_TRANSCRIPCION=
# FRONTEND_URL admite varios origenes separados por comas, p. ej.:
#   FRONTEND_URL=http://localhost:3000,https://mi-app.vercel.app
# PostgreSQL (Neon, Supabase): DATABASE_URL=postgresql+psycopg://usuario:clave@host/db?sslmode=require

# Cookies de YouTube (cookies.txt formato Netscape) para evitar bloqueos 'not a bot' / 429. Ej: cookies_youtube.txt
YOUTUBE_COOKIES=

# --- Sprint 5 ---
# Duracion maxima (minutos) de videos de YouTube/Vimeo a transcribir con audio + Whisper
MAX_DURACION_MIN=180
